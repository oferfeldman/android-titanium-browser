{
  "manifest_version": 3,
  "name": "Titanium Recipe Mode",
  "version": "1.2.2",
  "description": "Turn recipe pages into Skim cards using GPT-6.2 Sol.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://*/*"],
    "js": ["recipe.js"],
    "run_at": "document_idle"
  }]
}
